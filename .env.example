# Server-side only. Never prefix these with VITE_.
RESEND_API_KEY=
CONTACT_ORIGIN=https://gabcat.dev
# Rate-limit store. Upstash REST (preferred on Vercel):
CONTACT_KV_REST_API_URL=
CONTACT_KV_REST_API_TOKEN=
# Or a TCP Redis URL:
REDIS_URL=
# For bun dev, set CONTACT_ORIGIN=http://localhost:5173 in .env.local.
# The form fails closed until Resend is configured. Without Redis it uses in-memory limits.
