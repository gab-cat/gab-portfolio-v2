{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Types only. vite.config.ts decides which design `@design` really is; they all share one shape. */
    "paths": {
      "@design": ["./src/designs/signal/index.ts"],
      "@design/server": ["./src/designs/signal/server.tsx"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "server",
    "api"
  ],
  "exclude": [
    "server/**/*.test.ts"
  ]
}
